# ============================================================
# StudyTodo 配置模板（可安全入库）
#
# 用法：cp .env.example .env ，然后填自己的值；.env 已被 .gitignore 排除。
#       npm run config:gen   生成 nginx / systemd 等部署文件到 build/
#
# 所有值都是示例占位符，不含任何真实服务器信息。
# ============================================================

# ---- 站点 / 客户端 ----
APP_DOMAIN=your-domain.example
APP_BASE_URL=https://your-domain.example
APK_URL=https://your-domain.example/todo.apk
# 网页版默认跟随 location.origin；只有 file:// 打开时才用这个兜底，留空即可
WEB_SYNC_FALLBACK=

# ---- 服务端（部署机）----
DEPLOY_HOST=your-server.example
DEPLOY_USER=deploy
DEPLOY_DIR=/opt/studytodo
SYNC_BIND=127.0.0.1
SYNC_PORT=18080
SYNC_DB=/opt/studytodo/data/todo.db
SYNC_TOKEN=/opt/studytodo/token
SYNC_SECRET=/opt/studytodo/secret.key
SYNC_STATIC=/opt/studytodo/www
SYNC_BACKUP=/opt/studytodo/backup
PYTHON_BIN=/usr/bin/python3
SERVICE_NAME=studytodo-sync

# ---- nginx（部署机）----
NGINX_MAIN_CONF=/etc/nginx/nginx.conf
NGINX_INCLUDE_ANCHOR=include /etc/nginx/conf.d/*.conf;
WEBROOT=/var/www/studytodo
SSL_CERT=/opt/studytodo/cert/fullchain.pem
SSL_KEY=/opt/studytodo/cert/privkey.key
ACCESS_LOG=/var/log/nginx/studytodo_access.log
ERROR_LOG=/var/log/nginx/studytodo_error.log

# ---- Android 签名（本机，务必自己生成并备份）----
ANDROID_KEYSTORE=apps/native/keystore/dailytask.jks
ANDROID_KEYSTORE_PASSWORD=changeit
ANDROID_KEY_ALIAS=studytodo
ANDROID_KEY_PASSWORD=changeit
